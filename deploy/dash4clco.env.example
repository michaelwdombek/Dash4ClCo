# Dash4ClCo dashboard settings (EnvironmentFile of the quadlet). Keep mode 0600.

# Login token for the web UI (required). Generate: openssl rand -base64 32
D4CC_ADMIN_TOKEN=change-me

# URL the clients use to reach the dashboard; prefilled on the Deploy page.
#D4CC_PUBLIC_URL=http://10.8.0.1:8787

# Defaults for the thresholds (can be changed later on the Settings page).
#D4CC_STUCK_AFTER_MIN=30
#D4CC_OFFLINE_AFTER_MIN=15
#D4CC_DEAD_AFTER_HEARTBEATS=2
#D4CC_ENDED_VISIBLE_HOURS=24
#D4CC_RETENTION_DAYS=30
#D4CC_MIN_CLAUDE_VERSION=
